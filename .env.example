# Copy to .env in the repository root. All values below are intentionally empty.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DATA_PROVIDER=supabase
# Anthreed project only. Do not use any credentials from the legacy app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Vite never exposes this variable.
SUPABASE_SERVICE_ROLE_KEY=
